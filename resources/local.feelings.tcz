# Hangout's own feeling commands, written for Hangout in the format of TCZ's
# feelings file (see generic.feelings.tcz for the format).  A feeling here
# overrides a generic one with the same name.  $3$1 forms put the person
# first: 'hug Ben = tightly' gives 'You hug Ben tightly.'

# 'hug'  -  Hangout
 Feeling: hug;squeeze
Keywords: 
DKeyword: 
 DAction:
   Dtext: everyone
   Flags: DEFAULT|LIST
   UEcho: You hug $3$1.
   OEcho: %n hugs $3$1.

# 'smile'  -  Hangout
 Feeling: smile
Keywords: at;to
DKeyword: at
 DAction:
   Dtext:
   Flags: DEFAULT
   UEcho: You smile$1$2$3.
   OEcho: %n smiles$1$2$3.

