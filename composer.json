{
    "name": "ernestdefoe/hangout",
    "description": "Hangout: a light 2D talker world inside your forum, a modern web rewrite of The Chatting Zone (TCZ). Walk between rooms, talk in bubbles, page and tell, feelings, who list, ranks, channels, mail and the BBS.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "hangout",
        "talker",
        "chat",
        "mud",
        "tcz",
        "community"
    ],
    "type": "flarum-extension",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        },
        {
            "name": "J.P. Boggis",
            "role": "Original author of The Chatting Zone (TCZ), whose behaviour and text this ports"
        }
    ],
    "homepage": "https://github.com/ernestdefoe/hangout",
    "support": {
        "issues": "https://github.com/ernestdefoe/hangout/issues",
        "source": "https://github.com/ernestdefoe/hangout"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://buymeacoffee.com/ernestdefoe"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "ErnestDefoe\\Hangout\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ErnestDefoe\\Hangout\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Hangout",
            "category": "feature",
            "icon": {
                "name": "fas fa-couch",
                "backgroundColor": "#e8833a",
                "color": "#1a1d25"
            },
            "optional-dependencies": [
                "flarum/realtime",
                "flarum/flags",
                "flarum/suspend",
                "flarum/tags",
                "ernestdefoe/parley",
                "ramon/chat",
                "flarum/messages"
            ]
        }
    },
    "require-dev": {
        "ernestdefoe/parley": "^1.0",
        "flarum/flags": "^2.0",
        "flarum/messages": "^2.0",
        "flarum/phpstan": "^2.0",
        "flarum/suspend": "^2.0",
        "flarum/testing": "^2.0",
        "ramon/chat": ">=0.4"
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
